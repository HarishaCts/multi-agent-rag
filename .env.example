# Copy this file to `.env` and fill in your key to enable the Gemini backends.
# `.env` is gitignored so your key is never committed.

# Your Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=REPLACE_WITH_YOUR_KEY

# Turn on the Gemini backends (omit / set to the offline values to stay offline)
RAG_LLM_BACKEND=gemini           # gemini | offline
RAG_EMBED_BACKEND=gemini         # gemini | hashing
RAG_GEMINI_MODEL=gemini-2.0-flash

# If Gemini can't be reached (e.g. corporate TLS proxy), the app automatically
# falls back to the offline extractive path — it won't crash.
